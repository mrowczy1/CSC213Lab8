<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Scene?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<Scene xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx"
       fx:controller="controllers.ToggleTimerController">
	<fx:define>
		<Insets fx:id="insets" topRightBottomLeft="15"/>
		<Font fx:id="mediumFont" size="20"/>
		<Font fx:id="largeFont" size="32"/>
	</fx:define>
	<GridPane alignment="CENTER" hgap="15" vgap="15">
		<Text fx:id="duration" text="00:00.0" textAlignment="CENTER" font="$largeFont" GridPane.columnSpan="2"
		      GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.halignment="CENTER"/>
		<!-- TODO: Add your ToggleButton here -->
		<Button text="Reset" onAction="#handleReset" font="$mediumFont" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
	</GridPane>
</Scene>